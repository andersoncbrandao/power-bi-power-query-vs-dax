/*
===============================================
DAX - Classificação por Faixas
Exemplo reutilizável para Power BI

ALTERE:
1. 'SuaTabela' -> Nome da sua tabela
2. [Valor]     -> Coluna que deseja classificar
3. Os limites das faixas, se necessário
===============================================
*/

Faixa =
SWITCH(
    TRUE(),
    'SuaTabela'[Valor] <= 100, "Baixo",
    'SuaTabela'[Valor] <= 500, "Médio",
    "Alto"
)
